{
  "version": 1,
  "geometry": "compact",
  "sample_rate_hz": 48000,
  "output_device": "RME Fireface",
  "microphones": [
    {
      "id": "ear-left",
      "device": "RME Fireface",
      "input_channel": 0,
      "calibration_file": "calibrations/ear-left-90deg.txt",
      "calibration_orientation": "ninety_degrees",
      "gain_db": 0.0,
      "position_m": [-0.0875, 0.0, 1.2],
      "position_uncertainty_mm": 1.0
    },
    {
      "id": "ear-right",
      "device": "RME Fireface",
      "input_channel": 1,
      "calibration_file": "calibrations/ear-right-90deg.txt",
      "calibration_orientation": "ninety_degrees",
      "gain_db": 0.0,
      "position_m": [0.0875, 0.0, 1.2],
      "position_uncertainty_mm": 1.0
    }
  ],
  "sources": [
    {"id": "left", "output_channel": 0},
    {"id": "right", "output_channel": 1}
  ],
  "repeat_count": 2,
  "sweep": {
    "duration_secs": 5.0,
    "start_hz": 100.0,
    "end_hz": 20000.0,
    "amplitude": 0.1
  },
  "loopback": {
    "device": "RME Fireface",
    "input_channel": 7
  },
  "ctc": {
    "left_ear": "ear-left",
    "right_ear": "ear-right",
    "head_position": {
      "id": "main-seat",
      "x": 0.0,
      "y": 0.0,
      "z": 1.2,
      "yaw_deg": 0.0
    }
  }
}
